{
  "name": "grind",
  "version": "0.6.85",
  "description": "CLI tool for managing creative/technical projects from idea to publication",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "grind": "./grind"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile=grind",
    "typecheck": "tsc --noEmit",
    "test": "bun jest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.4",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
